SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Must match a Redirect URI in the Spotify Dashboard exactly (path included).
# Default in code is http://127.0.0.1:3000/api/auth/callback — use 127.0.0.1, not localhost, unless you register localhost in the dashboard.
SPOTIFY_REDIRECT_URI=""

# Optional: document canonical public URL for links/docs (not required for OAuth if SPOTIFY_REDIRECT_URI is set).
# NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# 32-byte secret for encrypting the Spotify refresh token cookie (any strong string).
# Generate: openssl rand -base64 32
SESSION_SECRET=""

# Supabase (server-only; never NEXT_PUBLIC_). Secret key bypasses RLS.
# New projects: use the "secret" API key (sb_secret_…) from Settings → API Keys.
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
